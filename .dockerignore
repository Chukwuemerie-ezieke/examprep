# Keep the build context small and prevent local secrets/artifacts from
# leaking into the image. dist/ and node_modules are rebuilt inside the image.

# Dependencies (reinstalled via `npm ci` in the build stage)
node_modules
**/node_modules

# Build output (regenerated by `npm run build` in the image)
dist
client/dist
server/public

# Secrets and local env files
.env
.env.*
!.env.example

# Version control and CI
.git
.gitignore
.github

# Tests, coverage, and agent/task tooling
coverage
**/*.test.ts
**/*.spec.ts
.agents
.kiro

# Editor / OS cruft
.DS_Store
*.log
npm-debug.log*

# Docker files themselves
Dockerfile
.dockerignore

# Misc archives / local databases
*.tar.gz
*.db
*.db-shm
*.db-wal
