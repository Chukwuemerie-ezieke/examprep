# ExamPrep environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# PostgreSQL connection string (required).
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/examprep

# Session signing secret (REQUIRED in production; the server throws on startup
# if unset when NODE_ENV=production). In non-production an ephemeral secret is
# generated with a warning (sessions do not survive a restart). Use a long,
# random value, e.g. `openssl rand -hex 32`.
SESSION_SECRET=change-me-to-a-long-random-string

# First-admin account bootstrap. On startup, if both ADMIN_EMAIL and
# ADMIN_PASSWORD are set and no user with that email exists, a user is created
# with isAdmin=true using ADMIN_PASSWORD as the account password (scrypt-hashed).
# This is idempotent: an existing admin is left untouched. Admin routes now
# authorize by the logged-in user's role, not by a header password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# HTTP port the server listens on (optional, defaults to 5000).
PORT=5000

# Node environment: "development" or "production".
NODE_ENV=development

# ALOC question-bank access token (OPTIONAL). Only needed for the ALOC source
# of the ingestion CLI (`npm run ingest -- --source=aloc ...`). Get a free token
# from the ALOC playground at https://questions.aloc.com.ng/ . The CLI reads it
# from the environment and never hardcodes it. NEVER commit a real token.
ALOC_ACCESS_TOKEN=
